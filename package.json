{
  "name": "quantum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @quantum/server --filter @quantum/web dev",
    "dev:server": "pnpm --filter @quantum/server dev",
    "dev:web": "pnpm --filter @quantum/web dev",
    "build": "pnpm --filter @quantum/shared build && pnpm --filter @quantum/server build && pnpm --filter @quantum/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @quantum/server test"
  }
}
