# Used by the server container (docker compose sets these).
# v1 start path is `docker compose up --build`, not host pnpm.
QUANTUM_PORT=43128
# Default is loopback. Intentional LAN/public bind must be explicit
# (QUANTUM_HOST plus compose `ports:`) — never leave the preview token as-is.
QUANTUM_HOST=127.0.0.1
QUANTUM_DATA_DIR=/data

# Weak loopback-only preview secret. Compose defaults to `local-preview`.
# Passed to the server and nginx (or the Vite dev proxy) only — never VITE_*.
# Nginx / Vite inject X-Quantum-Token on /api. The browser must not hold it.
# Change this before any LAN or public bind.
QUANTUM_API_TOKEN=local-preview

# Optional seed for settings → model proxy.
# Prefer the 我的 tab. Never commit real keys. Keys are never logged or sent in tool args.
# QUANTUM_MODEL_PROVIDER=openai
# QUANTUM_MODEL_ID=gpt-4o-mini
# QUANTUM_MODEL_BASE_URL=
# QUANTUM_MODEL_API_KEY=
